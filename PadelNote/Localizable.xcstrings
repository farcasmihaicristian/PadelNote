          "stringUnit" : {
            "state" : "translated",
            "value" : "El punto estrella es ventaja limitada: se aplica la ventaja clásica en las dos primeras igualdades y, en la tercera, se juega un punto de oro a muerte súbita."
          }
        }
      }
    },
